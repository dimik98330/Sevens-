# Local demo defaults. Copy to .env and fill secrets locally; never commit .env.
APP_ENV=demo
APP_ORIGIN=http://localhost:3000
APP_PORT=3000
# setup-demo.sh fills DATABASE_URL with the private Compose database address.
DATABASE_URL=
POSTGRES_DB=abai
POSTGRES_USER=abai_app
POSTGRES_PASSWORD=
UPLOAD_DIR=./storage/uploads
ATTACHMENT_STORAGE=filesystem
# Cloud launcher stores bytes in PostgreSQL and uses temporary staging.
API_INTERNAL_URL=http://api:18080
COOKIE_SECURE=false
DEMO_MODE=true
# Public sandbox shortcuts for judges; ignored outside APP_ENV=demo/test.
DEMO_LOGIN_ENABLED=true
DEMO_PASSWORD=
AI_ENABLED=false
MODEL_API_KEY=
LLM_BASE_URL=
LLM_MODEL=
# Site guidance is independent of idea routing. The API key stays server-only.
ASSISTANT_ENABLED=false
OPENAI_API_KEY=
OPENAI_ASSISTANT_MODEL=gpt-6-luna
# Server-only external LLM; set rules to disable paid calls. Missing key or
# provider failure falls back to rules-v2 and conservative manual review.
CLASSIFIER_MODE=llm
OPENAI_CLASSIFIER_MODEL=gpt-6-sol
ROUTING_CLASSIFIER_VERSION=rules-v2
LOG_LEVEL=info
# Shared only by private API and Next; configure the IP header ONLY behind
# trusted ingress that overwrites it and blocks direct access to Next.
API_PROXY_SECRET=
BRIDGE_CLIENT_IP_HEADER=
DB_CONNECTION_TIMEOUT_MS=5000
DB_STATEMENT_TIMEOUT_MS=10000
DB_QUERY_TIMEOUT_MS=15000
# Browser-visible 2GIS key with Map Tiles API access; keep the real value out of Git.
NEXT_PUBLIC_DGIS_MAP_KEY=
NEXT_PUBLIC_ABAI_MOCK=0
