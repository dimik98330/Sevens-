{
  "name": "sevens",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Sevens — resident ideas, routing and government feedback for Abai",
  "scripts": {
    "dev": "next dev",
    "dev:sevens": "node scripts/sevens-preview.mjs",
    "preview:sevens": "node scripts/sevens-preview.mjs --production",
    "dev:api": "npm run routing:build && node scripts/serve.mjs",
    "build": "npm run routing:build && next build",
    "start": "next start",
    "start:cloud": "node scripts/start-cloud.mjs",
    "typecheck": "tsc --noEmit",
    "test:unit": "vitest run",
    "test:integration": "npm run routing:build && node --test tests/integration/backend/*.test.mjs tests/integration/security/*.test.mjs",
    "routing:build": "node scripts/build-routing.mjs",
    "db:migrate": "node scripts/migrate.mjs",
    "db:seed": "node scripts/seed.mjs",
    "db:territories": "node scripts/import-abai-territories.mjs",
    "storage:import": "node scripts/import-attachments.mjs",
    "check": "npm run typecheck && npm run test:unit",
    "test:postgres": "npm run routing:build && node scripts/run-postgres-tests.mjs",
    "test:e2e": "node tests/e2e/backend-bridge.mjs",
    "test:browser": "node tests/e2e/sevens-browser.cjs",
    "verify:release": "node scripts/verify-release.mjs",
    "routing:evaluate": "node scripts/evaluate-routing.mjs",
    "storage:cleanup": "node scripts/cleanup-storage.mjs"
  },
  "dependencies": {
    "@2gis/mapgl": "1.78.1",
    "@2gis/mapgl-terra-draw": "0.4.0",
    "@electric-sql/pglite": "0.5.8",
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource-variable/manrope": "5.3.0",
    "@react-three/fiber": "9.8.1",
    "argon2": "0.45.1",
    "busboy": "1.6.0",
    "next": "16.3.6",
    "pg": "8.23.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "sharp": "0.35.5",
    "terra-draw": "1.35.0",
    "three": "0.186.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/node": "26.6.3",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/three": "0.186.0",
    "playwright": "1.62.1",
    "typescript": "5.9.3",
    "vitest": "5.0.2"
  },
  "engines": {
    "node": ">=22"
  }
}
